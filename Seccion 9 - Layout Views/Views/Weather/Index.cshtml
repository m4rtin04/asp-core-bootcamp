@model IEnumerable<CityWeather>

@{
    ViewData["Title"] = "Weather App";

    string GetBackgroundClass(int temp)
    {
        if (temp < 44) return "blue-back";
        if (temp >= 44 && temp <= 74) return "green-back";
        return "orange-back";
    }
}

<h2>Cities Weather Details</h2>

<div class="flex margin-top">
    @foreach (var city in Model)
    {
        <div class="@GetBackgroundClass(city.TemperatureFahrenheit) w-25">
            <h3>@city.CityName</h3>
            <p><strong>Code:</strong> @city.CityUniqueCode</p>
            <p>
                <strong>Date/Time:</strong>
                @city.DateAndTime.ToString("yyyy-MM-dd HH:mm")
            </p>
            <p>
                <strong>Temperature:</strong>
                @city.TemperatureFahrenheit °F
            </p>
            <br />
            <a href="/weather/@city.CityUniqueCode">Details</a>
        </div>
    }
</div>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/StyleSheet.css" asp-append-version="true" />
    <style>
            .price-container { font-size: 2.5em; font-weight: bold; }
            .button { color: #fff; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-size: 0.9em; }
            .button-sell { background-color: #b83c14; }
            .button-buy { background-color: #1e7e2e; }
            .quantity-input { width: 100px; padding: 4px; font-size: 0.9em; }
            .order-item { border-bottom: 1px solid #999; padding: 10px 0; }
            .order-title { font-weight: bold; }
            .order-small { font-size: 0.75em; }
            .explore-grid {
                display: flex;
                gap: 20px;
                align-items: flex-start;
                padding: 10px;
            }

            .stock-list {
                width: 380px;
                flex-shrink: 0;
            }

            .stock-item, .stock-item:link, .stock-item:visited {
                display: block;
                background: #fff;
                border: 1px solid #ddd;
                border-radius: 4px;
                padding: 8px 10px;
                margin-bottom: 4px;
                color: #000;
                font-size: 0.75em;
                text-decoration: none;
            }

                .stock-item:hover {
                    background: #e9f3fa;
                    text-decoration: none;
                }

            .stock-detail {
                flex: 1;
            }

            .stock-logo {
                width: 150px;
                height: 150px;
                background: #000;
                object-fit: contain;
            }

            .tag {
                display: inline-block;
                background: #888;
                color: #fff;
                padding: 2px 8px;
                border-radius: 4px;
                font-size: 0.7em;
            }

            .button-trade {
                background-color: #2d6cb5;
                text-decoration: none;
                display: inline-block;
            }

                .button-trade:link, .button-trade:visited {
                    color: #fff;
                }
    </style>
</head>
<body>
    <div class="navbar">
        <span class="navbar-brand">Stocks</span>
        <ul>
            <li>
                <a asp-controller="Trade" asp-action="Index"
                   class="@(ViewBag.ActiveMenu == "Trade" ? "nav-active" : "")">Trade</a>
            </li>
            <li>
                <a asp-controller="Trade" asp-action="Orders"
                   class="@(ViewBag.ActiveMenu == "Orders" ? "nav-active" : "")">Orders</a>
            </li>
            <li>
                <a asp-controller="Stocks" asp-action="Explore"
                   class="@(ViewBag.ActiveMenu == "Explore" ? "nav-active" : "")">Explore</a>
            </li>
        </ul>
    </div>

    <div class="container">
        @RenderBody()
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>
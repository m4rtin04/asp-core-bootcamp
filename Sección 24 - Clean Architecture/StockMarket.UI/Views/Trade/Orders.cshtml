@model Orders
@{ ViewBag.Title = "Orders"; }

<div class="orders-header">
    <h2>Orders</h2>
    <a class="button button-blue-back" asp-controller="Trade" asp-action="OrdersPDF">Download as PDF</a>
</div>

<div class="orders-grid">
    <section class="card">
        <h3>Buy Orders</h3>
        @foreach (var order in Model.BuyOrders)
        {
            <div class="order-box">
                <div class="order-title">@order.StockName (@order.StockSymbol)</div>
                <div>@order.Quantity shares @@ $@order.Price.ToString("0.00")</div>
                <div class="order-date">@order.DateAndTimeOfOrder.ToString("dd MMM yyyy, hh:mm tt")</div>
                <div class="order-amount">Trade amount: $@order.TradeAmount.ToString("N2")</div>
            </div>
        }
        @if (Model.BuyOrders.Count == 0) { <p class="empty">No buy orders yet.</p> }
    </section>

    <section class="card">
        <h3>Sell Orders</h3>
        @foreach (var order in Model.SellOrders)
        {
            <div class="order-box">
                <div class="order-title">@order.StockName (@order.StockSymbol)</div>
                <div>@order.Quantity shares @@ $@order.Price.ToString("0.00")</div>
                <div class="order-date">@order.DateAndTimeOfOrder.ToString("dd MMM yyyy, hh:mm tt")</div>
                <div class="order-amount">Trade amount: $@order.TradeAmount.ToString("N2")</div>
            </div>
        }
        @if (Model.SellOrders.Count == 0) { <p class="empty">No sell orders yet.</p> }
    </section>
</div>

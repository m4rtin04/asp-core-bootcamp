@model CityWeather
@{
    ViewData["Title"] = $"{Model.CityName} Weather";

    string GetBackgroundClass(int temp)
    {
        if (temp < 44) return "blue-back";
        if (temp >= 44 && temp <= 74) return "green-back";
        return "orange-back";
    }
}
<!Doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Weather App</h1>
        </div>

        <div class="page-content">
            <a href="/">Back to Home</a>
            <div class="margin-top">
                <div class="box @GetBackgroundClass(Model.TemperatureFahrenheit) w-50 margin-auto">
                    <h2>@Model.CityName (@Model.CityUniqueCode)</h2>
                    <p class="margin-top"><strong>Date and Time:</strong> @Model.DateAndTime.ToString("yyyy-MM-dd HH:mm")</p>
                    <p class="margin-top"><strong>Temperature:</strong> @Model.TemperatureFahrenheit °F</p>
                </div>
            </div>
        </div>
    </div>
</body>

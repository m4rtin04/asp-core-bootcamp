@model IEnumerable<CityWeather>
@{
    ViewData["Title"] = "Weather App";

    // Función local para determinar la clase CSS según la temperatura
    string GetBackgroundClass(int temp)
    {
        if (temp < 44) return "blue-back";
        if (temp >= 44 && temp <= 74) return "green-back";
        return "orange-back";
    }
}
<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
    </head>
    <body>  
    <div class="container">
        <div class="header">
            <h1>Weather App</h1>
        </div>

        <div class="page-content">
            <h2>Cities Weather Details</h2>
            <div class="flex margin-top">
                @foreach (var city in Model)
                {
                    <div class="@GetBackgroundClass(city.TemperatureFahrenheit) w-25">
                        <h3>@city.CityName</h3>
                        <p><strong>Code:</strong> @city.CityUniqueCode</p>
                        <p><strong>Date/Time:</strong> @city.DateAndTime.ToString("yyyy-MM-dd HH:mm")</p>
                        <p><strong>Temperature:</strong> @city.TemperatureFahrenheit °F</p>
                        <br />
                        <a href="/weather/@city.CityUniqueCode">Details</a>
                    </div>
                }
            </div>
        </div>
    </div>
    </body>
</html>
